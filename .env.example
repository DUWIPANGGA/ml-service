# ── Server ───────────────────────────────────────────────────────────────────
# Service TIDAK punya autentikasi. Default 127.0.0.1 = hanya nginx di mesin
# sama yang boleh menembak. Docker/systemd menimpanya (Docker: 0.0.0.0).
HOST=127.0.0.1
# 8009 — port 8000 sudah dipakai backend Laravel (run_dev.ps1).
PORT=8009
# 1 = disarankan. Tiap worker memuat salinan model 327 MB sendiri ke RAM.
WORKERS=1
# Batas antar-request (opsional, kosongkan bila di belakang proxy).
LIMIT_CONCURRENCY=
TIMEOUT_KEEP_ALIVE=30

# ── Model ────────────────────────────────────────────────────────────────────
# Arsitektur dasar Hugging Face — hanya dipakai bila MODEL_PATH berupa
# 1 file state_dict (bentuk folder save_pretrained tidak butuh ini).
BASE_MODEL_ID=google/vit-base-patch16-224

# Checkpoint fine-tuned 11 kelas.
#   Folder save_pretrained (config.json + model.safetensors + preprocessor_config.json)
#   ATAU 1 file state_dict (.safetensors / .pt / .bin)
# Default: ./models (relative ke folder ml-service)
MODEL_PATH=models

# Versi model untuk response (model_version)
MODEL_VERSION=vit-v1.0.0

# Label map (11 kelas penyakit ikan) — urutan array = indeks kelas model.
# Sinkron dengan tabel diseases Laravel lewat `php artisan ml:sync-label-map`.
LABEL_MAP_PATH=label_map.json

# auto | cpu | cuda | cuda:0 | mps
DEVICE=auto

# true  -> larang akses Hugging Face Hub. AMAN untuk MODEL_PATH folder
#          save_pretrained lengkap; dipakai di Docker agar deterministik.
# false -> wajib bila MODEL_PATH 1 file state_dict (arsitektur diunduh dari hub).
HF_OFFLINE=false

# ── Prediksi ────────────────────────────────────────────────────────────────
# Hard limit inferensi detik -> 504 INFERENCE_TIMEOUT (NFR-01.2)
PREDICT_TIMEOUT_SECONDS=30
# Confidence < ini -> low_confidence_warning (FR-02.2.3)
LOW_CONFIDENCE_THRESHOLD=60
PREDICT_WORKERS=2

# ── Upload ──────────────────────────────────────────────────────────────────
MAX_IMAGE_BYTES=10485760
MAX_BATCH_IMAGES=5

# ── Kualitas gambar (FR-10.12) ──────────────────────────────────────────────
# Variance-of-Laplacian < ini -> blur (toleransi kamera HP)
BLUR_MIN_VARIANCE=60
# Brightness rata-rata (0-255)
DARK_MAX_BRIGHTNESS=40
BRIGHT_MIN_BRIGHTNESS=235

# ── GradCAM (FR-10.8) ───────────────────────────────────────────────────────
# true menambah ±10 detik per prediksi — pastikan ML_TIMEOUT di backend
# dan proxy_read_timeout di nginx masih di atas itu.
GRADCAM_ENABLED=true

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
